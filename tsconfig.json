{
  "compilerOptions": {
    "noEmit": true,
    "checkJs": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "saveReasoning.js",
    "getReasoningContent.js",
    "normalizeModelName.js"
  ]
}
